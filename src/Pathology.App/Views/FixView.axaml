<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Pathology.App.ViewModels"
             xmlns:views="clr-namespace:Pathology.App.Views"
             xmlns:controls="clr-namespace:Pathology.App.Controls"
             x:Class="Pathology.App.Views.FixView"
             x:DataType="vm:FixViewModel">

    <UserControl.Styles>
        <!-- Common.axaml's .help/.field match TextBlock exactly; the notes here are CharWrapTextBlocks. -->
        <Style Selector="controls|CharWrapTextBlock.help">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style Selector="controls|CharWrapTextBlock.field">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
        </Style>

        <!-- The editor's small row buttons: compact, neutral, one per action. -->
        <Style Selector="Button.tool">
            <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonNeutralTextBrush}" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonNeutralHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonNeutralTextBrush}" />
        </Style>
        <Style Selector="Border.draftrow">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.draftrow.highlighted">
            <Setter Property="Background" Value="{DynamicResource NavItemActiveBgBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*" Margin="32,36,32,24">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Classes="pagetitle" Text="Fix" />
                <TextBlock Classes="help"
                           Text="Pick the fixes, adjust the PATH if you like, and check what changes. Nothing is written until you apply, and a backup is kept so you can undo it from History." />
            </StackPanel>
            <Button Grid.Column="1" Classes="secondary" VerticalAlignment="Top" Margin="16,0,0,0"
                    Content="{Binding RescanLabel}" Command="{Binding RescanCommand}" />
        </Grid>

        <views:ScanStatusPanel Grid.Row="1" Margin="0,0,0,14">
            <views:ScanStatusPanel.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                    <Binding Path="!HasResult" />
                    <Binding Path="IsScanning" />
                </MultiBinding>
            </views:ScanStatusPanel.IsVisible>
        </views:ScanStatusPanel>

        <Grid Grid.Row="2" ColumnDefinitions="1.15*,*" ColumnSpacing="14" IsVisible="{Binding HasResult}">

            <!-- Left: the fixes, then the PATH as it would be. -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14" Margin="0,0,4,0">

                    <Border Classes="panel" Padding="14,14">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="phead" Text="{Binding FixesHeading}" Margin="6,0" />
                            <TextBlock Classes="help" Margin="6,0" IsVisible="{Binding !HasFixes}"
                                       Text="Nothing here has an automatic fix. You can still edit the PATH below." />
                            <ItemsControl ItemsSource="{Binding Fixes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FixRowViewModel">
                                        <Border Classes="draftrow" Padding="6,6">
                                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Top"
                                                          Margin="0,-4,0,0" AutomationProperties.Name="{Binding Title}" />
                                                <Ellipse Grid.Column="1" Width="8" Height="8" VerticalAlignment="Top"
                                                         Margin="0,6,0,0" Fill="{Binding SeverityBrush}" />
                                                <StackPanel Grid.Column="2" Spacing="2">
                                                    <controls:CharWrapTextBlock Source="{Binding Title}" Prose="True" FontSize="13"
                                                                                Foreground="{DynamicResource FgBrush}" />
                                                    <controls:CharWrapTextBlock Source="{Binding Problem}" Prose="True" Classes="help" FontSize="11.5"
                                                                                Foreground="{DynamicResource MutedBrush}" />
                                                    <controls:CharWrapTextBlock Source="{Binding Note}" Prose="True" FontSize="11.5"
                                                                                Foreground="{DynamicResource WarnBrush}"
                                                                                IsVisible="{Binding HasNote}" />
                                                    <TextBlock Text="{Binding Meta}" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Classes="panel" Padding="14,14">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" Margin="6,0">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Classes="phead" Text="THE PATH AS IT WOULD BE" />
                                    <TextBlock Classes="help" Text="The fixes above, plus any edits you make here. Search order, top to bottom." />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="link" VerticalAlignment="Top" FontSize="12"
                                        Content="Reset my edits" Command="{Binding ResetEditsCommand}" IsVisible="{Binding HasEdits}" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Sections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DraftSectionViewModel">
                                        <StackPanel Margin="0,0,0,12">
                                            <Grid ColumnDefinitions="*,Auto" Margin="6,4,6,4">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Classes="phead" Text="{Binding Heading}" VerticalAlignment="Center" />
                                                    <TextBlock Classes="help" Text="{Binding Summary}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="link" FontSize="11.5" Content="Recommended order"
                                                        ToolTip.Tip="Windows folders first, then folders only administrators can write, then writable ones"
                                                        Command="{Binding $parent[UserControl].((vm:FixViewModel)DataContext).RecommendedOrderCommand}"
                                                        CommandParameter="{Binding}" IsVisible="{Binding HasRows}" />
                                            </Grid>
                                            <TextBlock Classes="help" Margin="6,2" Text="Empty." IsVisible="{Binding !HasRows}" />
                                            <ItemsControl ItemsSource="{Binding Rows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:DraftRowViewModel">
                                                        <Border Classes="draftrow" Classes.highlighted="{Binding IsHighlighted}">
                                                            <Grid ColumnDefinitions="34,*,Auto">
                                                                <TextBlock Grid.Column="0" Text="{Binding Number}" Classes="help"
                                                                           VerticalAlignment="Top" Margin="0,2,0,0" />
                                                                <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,10,0">
                                                                    <controls:CharWrapTextBlock Source="{Binding Text}" Classes="mono"
                                                                                                IsVisible="{Binding !IsEditing}" />
                                                                    <TextBox Text="{Binding EditText}" FontFamily="Cascadia Code, Consolas, monospace"
                                                                             FontSize="12" IsVisible="{Binding IsEditing}"
                                                                             AutomationProperties.Name="Entry text">
                                                                        <TextBox.KeyBindings>
                                                                            <KeyBinding Gesture="Enter" Command="{Binding SaveEditCommand}" />
                                                                            <KeyBinding Gesture="Escape" Command="{Binding CancelEditCommand}" />
                                                                        </TextBox.KeyBindings>
                                                                    </TextBox>
                                                                    <controls:CharWrapTextBlock Source="{Binding Status}" Prose="True" FontSize="10.5"
                                                                                                Foreground="{Binding StatusBrush}"
                                                                                                IsVisible="{Binding HasStatus}" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Top">
                                                                    <Button Classes="tool" Content="↑" ToolTip.Tip="Search it earlier" Command="{Binding MoveUpCommand}" />
                                                                    <Button Classes="tool" Content="↓" ToolTip.Tip="Search it later" Command="{Binding MoveDownCommand}" />
                                                                    <Button Classes="tool" Content="{Binding MoveLabel}" ToolTip.Tip="{Binding MoveTip}" Command="{Binding MoveScopeCommand}" />
                                                                    <Button Classes="tool" Content="Edit" Command="{Binding BeginEditCommand}" IsVisible="{Binding !IsEditing}" />
                                                                    <Button Classes="tool" Content="Save" Command="{Binding SaveEditCommand}" IsVisible="{Binding IsEditing}" />
                                                                    <Button Classes="tool" Content="×" ToolTip.Tip="Remove it" Command="{Binding RemoveCommand}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <StackPanel Margin="40,4,6,0" Spacing="2" IsVisible="{Binding HasRemoved}">
                                                <TextBlock Classes="help" Text="Taken out:" />
                                                <ItemsControl ItemsSource="{Binding Removed}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <controls:CharWrapTextBlock Source="{Binding}" Classes="mono" FontSize="11.5"
                                                                                        Foreground="{DynamicResource MutedBrush}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="6,0">
                                <TextBox Grid.Column="0" Text="{Binding NewEntryText}" PlaceholderText="Add a folder, e.g. C:\Program Files\Tool\bin"
                                         FontFamily="Cascadia Code, Consolas, monospace" FontSize="12"
                                         AutomationProperties.Name="New entry">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <ToggleButton Grid.Column="1" Classes="chip" IsChecked="{Binding NewEntryInUser}" VerticalAlignment="Center"
                                              ToolTip.Tip="On: your user PATH. Off: the machine PATH (needs admin)">
                                    <Panel>
                                        <TextBlock Text="to my user PATH" IsVisible="{Binding NewEntryInUser}" />
                                        <TextBlock Text="to the machine PATH" IsVisible="{Binding !NewEntryInUser}" />
                                    </Panel>
                                </ToggleButton>
                                <Button Grid.Column="2" Classes="secondary" Content="Add" Command="{Binding AddCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right: what applying would change. -->
            <Border Grid.Column="1" Classes="panel" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,20" Spacing="16">

                        <StackPanel Spacing="6" IsVisible="{Binding HasApplyStatus}">
                            <SelectableTextBlock Text="{Binding ApplyStatus}" FontSize="13" TextWrapping="Wrap"
                                                 Classes="status" Classes.err="{Binding ApplyFailed}" Classes.ok="{Binding !ApplyFailed}" />
                            <ItemsControl ItemsSource="{Binding ApplySteps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StepRowViewModel">
                                        <Grid ColumnDefinitions="64,*" Margin="0,2">
                                            <TextBlock Grid.Column="0" Text="{Binding Status}" FontSize="11.5" Foreground="{Binding Brush}" />
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <controls:CharWrapTextBlock Source="{Binding Target}" Classes="mono" FontSize="11.5" />
                                                <controls:CharWrapTextBlock Source="{Binding Message}" Prose="True" Classes="help"
                                                                            FontSize="11" IsVisible="{Binding HasMessage}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel DataContext="{Binding Plan}" x:DataType="vm:PlanViewModel" Spacing="16">

                            <TextBlock Classes="phead" Text="WHAT CHANGES" />
                            <TextBlock Classes="help" IsVisible="{Binding !HasChanges}"
                                       Text="Nothing yet: tick a fix or edit an entry to see what it would change." />

                            <!-- The ratings, now and after. -->
                            <ItemsControl ItemsSource="{Binding Ratings}" IsVisible="{Binding HasChanges}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RatingChangeViewModel">
                                        <Grid ColumnDefinitions="110,Auto,Auto,Auto" ColumnSpacing="10" Margin="0,2">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="help" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Before}" FontWeight="Bold" FontSize="13"
                                                       LetterSpacing="1" Foreground="{Binding BeforeBrush}" />
                                            <TextBlock Grid.Column="2" Text="→" Foreground="{DynamicResource MutedBrush}" />
                                            <TextBlock Grid.Column="3" Text="{Binding After}" FontWeight="Bold" FontSize="13"
                                                       LetterSpacing="1" Foreground="{Binding AfterBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding ResolvedLine}" Classes="field" IsVisible="{Binding HasResolved}" />

                            <StackPanel Spacing="4" IsVisible="{Binding HasIntroduced}">
                                <TextBlock Classes="phead" Text="NEW PROBLEMS IT WOULD CAUSE" />
                                <ItemsControl ItemsSource="{Binding Introduced}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:IntroducedViewModel">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,2">
                                                <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Top" Margin="0,5,0,0"
                                                         Fill="{Binding Brush}" />
                                                <controls:CharWrapTextBlock Grid.Column="1" Source="{Binding Title}" Prose="True" Classes="field" FontSize="12.5" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Each value, as a short diff. -->
                            <ItemsControl ItemsSource="{Binding Values}" IsVisible="{Binding HasValues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ValueDiffViewModel">
                                        <StackPanel Spacing="4" Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Classes="phead" Text="{Binding Heading}" />
                                                <TextBlock Classes="help" Text="{Binding LengthLine}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding KindLine}" Classes="field" FontSize="12" IsVisible="{Binding HasKindLine}" />
                                            <ItemsControl ItemsSource="{Binding Lines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:DiffLineViewModel">
                                                        <Grid ColumnDefinitions="18,*" Margin="0,1">
                                                            <TextBlock Grid.Column="0" Text="{Binding Marker}" Foreground="{Binding Brush}"
                                                                       FontWeight="Bold" Classes="mono" />
                                                            <StackPanel Grid.Column="1">
                                                                <controls:CharWrapTextBlock Source="{Binding Text}" Classes="mono" Foreground="{Binding Brush}" />
                                                                <controls:CharWrapTextBlock Source="{Binding Note}" Prose="True" Classes="help" FontSize="11"
                                                                                            IsVisible="{Binding HasNote}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding UnchangedLine}" Classes="help" IsVisible="{Binding HasUnchanged}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Each folder's permissions. -->
                            <StackPanel Spacing="6" IsVisible="{Binding HasAcls}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="phead" Text="FOLDER PERMISSIONS" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="link" FontSize="12" Content="Copy as icacls commands"
                                            Click="OnCopyCommands" IsVisible="{Binding HasCommandsText}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Acls}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AclChangeViewModel">
                                            <StackPanel Spacing="3" Margin="0,0,0,10">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <controls:CharWrapTextBlock Grid.Column="0" Source="{Binding Path}" Classes="mono" />
                                                    <Border Grid.Column="1" Classes="pill" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Badge}" FontSize="10.5" Foreground="{Binding BadgeBrush}" />
                                                    </Border>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Lines}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,1">
                                                                <TextBlock Grid.Column="0" Text="–" Foreground="{DynamicResource MutedBrush}" />
                                                                <controls:CharWrapTextBlock Grid.Column="1" Source="{Binding}" Prose="True"
                                                                                            FontSize="12" Foreground="{DynamicResource FgBrush}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <controls:CharWrapTextBlock Source="{Binding Note}" Prose="True" Classes="help" FontSize="11.5"
                                                                            IsVisible="{Binding HasNote}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Which commands would run something else. -->
                            <StackPanel Spacing="4" IsVisible="{Binding HasCommands}">
                                <TextBlock Classes="phead" Text="COMMANDS THAT WOULD RUN SOMETHING ELSE" />
                                <ItemsControl ItemsSource="{Binding Commands}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CommandChangeViewModel">
                                            <Grid ColumnDefinitions="90,*" Margin="0,3">
                                                <TextBlock Grid.Column="0" Text="{Binding Command}" Classes="mono" Foreground="{Binding Brush}"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <controls:CharWrapTextBlock Source="{Binding Before}" Classes="mono" FontSize="11.5"
                                                                                Foreground="{DynamicResource MutedBrush}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="→" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" />
                                                        <controls:CharWrapTextBlock Source="{Binding After}" Classes="mono" FontSize="11.5" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding MoreCommands}" Classes="help" IsVisible="{Binding HasMoreCommands}" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Problems}" IsVisible="{Binding HasProblems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" Classes="status err" TextWrapping="Wrap" FontSize="12.5" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding AdminLine}" Classes="field" FontSize="12.5" TextWrapping="Wrap"
                                       IsVisible="{Binding HasChanges}" />
                        </StackPanel>

                        <!-- Apply, then confirm. -->
                        <StackPanel Spacing="10">
                            <Button Classes="primary" HorizontalAlignment="Left" Content="Apply…" Command="{Binding ApplyCommand}"
                                    IsVisible="{Binding !IsConfirming}" />
                            <Border Classes="panel" Background="{DynamicResource FormBgBrush}" IsVisible="{Binding IsConfirming}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Apply these changes?" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TitleBrush}" />
                                    <TextBlock Classes="help" TextWrapping="Wrap"
                                               Text="First a backup of each PATH value and each folder's permissions goes into History. Then the parts that need an administrator are applied behind one UAC prompt, and the rest as you. Each write is read back to check it. New programs get the new PATH; ones already open keep the old one until restarted." />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Classes="primary" Content="Apply now" Command="{Binding ConfirmCommand}" />
                                        <Button Classes="secondary" Content="Cancel" Command="{Binding CancelApplyCommand}" />
                                        <TextBlock Text="Applying…" Classes="help" VerticalAlignment="Center" IsVisible="{Binding IsApplying}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
