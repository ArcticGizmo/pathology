<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Pathology.App.ViewModels"
             xmlns:views="clr-namespace:Pathology.App.Views"
             xmlns:controls="clr-namespace:Pathology.App.Controls"
             x:Class="Pathology.App.Views.FindingsView"
             x:DataType="vm:FindingsViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="32,36,32,24">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Classes="pagetitle" Text="Findings" />
                <TextBlock Classes="help"
                           Text="Every problem found, worst first. Findings that share a cause are one problem, listed once." />
            </StackPanel>
            <Button Grid.Column="1" Classes="secondary" VerticalAlignment="Top" Margin="16,0,0,0"
                    Content="{Binding RescanLabel}" Command="{Binding RescanCommand}" />
        </Grid>

        <views:ScanStatusPanel Grid.Row="1" Margin="0,0,0,14">
            <views:ScanStatusPanel.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                    <Binding Path="!HasResult" />
                    <Binding Path="IsScanning" />
                </MultiBinding>
            </views:ScanStatusPanel.IsVisible>
        </views:ScanStatusPanel>

        <!-- Filters -->
        <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12" IsVisible="{Binding HasResult}">
            <ComboBox ItemsSource="{Binding SeverityOptions}" SelectedItem="{Binding Severity}" MinWidth="150"
                      Margin="0,0,8,6" AutomationProperties.Name="Severity" />
            <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding Category}" MinWidth="150"
                      Margin="0,0,8,6" AutomationProperties.Name="Category" />
            <ComboBox ItemsSource="{Binding ScopeOptions}" SelectedItem="{Binding Scope}" MinWidth="150"
                      Margin="0,0,8,6" AutomationProperties.Name="Scope" />
            <ComboBox ItemsSource="{Binding PerspectiveOptions}" SelectedItem="{Binding Perspective}" MinWidth="150"
                      Margin="0,0,14,6" AutomationProperties.Name="Who it concerns" />
            <TextBlock Text="{Binding CountLine}" Classes="help" VerticalAlignment="Center" Margin="0,0,0,6" />
        </WrapPanel>

        <!-- Master / detail -->
        <Grid Grid.Row="3" ColumnDefinitions="*,1.3*" ColumnSpacing="14" IsVisible="{Binding HasResult}">

            <Border Grid.Column="0" Classes="panel" Padding="6" MaxWidth="{StaticResource ListPaneMaxWidth}">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FindingRowViewModel">
                                    <Button Classes="row" Classes.selected="{Binding IsSelected}"
                                            Command="{Binding OpenCommand}" Padding="10,8" Margin="0,1">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Top"
                                                     Margin="0,5,0,0" Fill="{Binding SeverityBrush}" />
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock Text="{Binding Title}" FontSize="13"
                                                           Foreground="{DynamicResource FgBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Meta}" FontSize="11"
                                                           Foreground="{DynamicResource MutedBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Classes="help" Margin="14" IsVisible="{Binding IsEmpty}"
                               Text="Nothing matches these filters." />
                </Grid>
            </Border>

            <Border Grid.Column="1" Classes="panel" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding Detail}" x:DataType="vm:FindingDetailViewModel"
                                Margin="22,20" Spacing="16"
                                IsVisible="{Binding $parent[UserControl].((vm:FindingsViewModel)DataContext).HasSelection}">

                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" LetterSpacing="1"
                                       Foreground="{Binding SeverityBrush}" />
                            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TitleBrush}" TextWrapping="Wrap" />
                            <Button Classes="link" HorizontalAlignment="Left" FontSize="12"
                                    Content="← Back to the main finding" Command="{Binding ShowLeadCommand}"
                                    IsVisible="{Binding !IsShowingLead}" />
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Classes="phead" Text="WHAT" />
                            <controls:CharWrapTextBlock Source="{Binding What}" Prose="True" Classes="field" />
                        </StackPanel>
                        <StackPanel Spacing="5">
                            <TextBlock Classes="phead" Text="WHY IT MATTERS" />
                            <controls:CharWrapTextBlock Source="{Binding Why}" Prose="True" Classes="field" />
                        </StackPanel>
                        <StackPanel Spacing="5">
                            <TextBlock Classes="phead" Text="HOW TO FIX IT" />
                            <controls:CharWrapTextBlock Source="{Binding Fix}" Prose="True" Classes="field" />
                        </StackPanel>

                        <StackPanel Spacing="4" IsVisible="{Binding HasEntries}">
                            <TextBlock Classes="phead" Text="ENTRIES" />
                            <ItemsControl ItemsSource="{Binding Entries}" Margin="-8,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EntryLinkViewModel">
                                        <Button Classes="row" Command="{Binding OpenCommand}" Padding="8,4">
                                            <Grid ColumnDefinitions="92,*">
                                                <TextBlock Grid.Column="0" Text="{Binding Position}" Classes="help"
                                                           VerticalAlignment="Top" Margin="0,1,0,0" />
                                                <TextBlock Grid.Column="1" Classes="mono" TextWrapping="Wrap"
                                                           Text="{Binding Display}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="5" IsVisible="{Binding HasPerspectives}">
                            <TextBlock Classes="phead" Text="WHO IT CONCERNS" />
                            <TextBlock Text="{Binding Perspectives}" Classes="field" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="5" IsVisible="{Binding HasEvidence}">
                            <TextBlock Classes="phead" Text="EVIDENCE" />
                            <ItemsControl ItemsSource="{Binding Evidence}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,2">
                                            <TextBlock Grid.Column="0" Text="–" Foreground="{DynamicResource MutedBrush}" />
                                            <controls:CharWrapTextBlock Grid.Column="1" Source="{Binding}" Prose="True"
                                                                        FontSize="12.5"
                                                                        Foreground="{DynamicResource FgBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="4" IsVisible="{Binding HasRelated}">
                            <TextBlock Classes="phead" Text="SAME CAUSE, ALSO FOUND BY" />
                            <ItemsControl ItemsSource="{Binding Related}" Margin="-8,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RelatedFindingViewModel">
                                        <Button Classes="row" Command="{Binding OpenCommand}" Padding="8,5">
                                            <Grid ColumnDefinitions="Auto,60,*" ColumnSpacing="8">
                                                <Ellipse Grid.Column="0" Width="7" Height="7" VerticalAlignment="Top"
                                                         Margin="0,5,0,0" Fill="{Binding SeverityBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Rule}" Classes="help" />
                                                <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="12.5"
                                                           Foreground="{DynamicResource FgBrush}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Button Classes="secondary" Content="Copy details" Click="OnCopyDetails" />
                            <Button Classes="link" VerticalAlignment="Center" Content="{Binding LearnLabel}"
                                    Command="{Binding OpenLearnCommand}" IsVisible="{Binding HasLearn}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
