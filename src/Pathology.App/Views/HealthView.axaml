<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Pathology.App.ViewModels"
             xmlns:views="clr-namespace:Pathology.App.Views"
             xmlns:controls="clr-namespace:Pathology.App.Controls"
             x:Class="Pathology.App.Views.HealthView"
             x:DataType="vm:HealthViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="980" Margin="32,36,32,32" HorizontalAlignment="Stretch" Spacing="18">

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Classes="pagetitle" Text="PATH health" />
                    <TextBlock Classes="help"
                               Text="How safe, correct and tidy this PC's PATH is. Each category is rated by its worst problem, so fixing the worst always shows." />
                </StackPanel>
                <Button Grid.Column="1" Classes="secondary" VerticalAlignment="Top" Margin="16,0,0,0"
                        Content="{Binding RescanLabel}" Command="{Binding RescanCommand}" />
            </Grid>

            <views:ScanStatusPanel />

            <!-- The three ratings, side by side. No overall verdict: they stand on their own. -->
            <ItemsControl ItemsSource="{Binding Cards}" IsVisible="{Binding HasResult}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" ColumnSpacing="14" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryCardViewModel">
                        <Border Classes="panel" VerticalAlignment="Stretch">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Spacing="4">
                                    <TextBlock Classes="phead" Text="{Binding Heading}" />
                                    <TextBlock Text="{Binding RatingWord}" FontSize="30" FontWeight="Bold"
                                               LetterSpacing="1" Foreground="{Binding RatingBrush}" />
                                    <TextBlock Text="{Binding CountsLine}" Classes="field" />
                                    <TextBlock Text="{Binding HintLine}" Classes="help"
                                               IsVisible="{Binding !IsClean}" />
                                </StackPanel>

                                <Button DockPanel.Dock="Bottom" Classes="link" HorizontalAlignment="Left"
                                        Margin="0,10,0,0" FontSize="12"
                                        Content="{Binding AllLabel}" Command="{Binding OpenCommand}"
                                        IsVisible="{Binding !IsClean}" />

                                <ItemsControl ItemsSource="{Binding Problems}" Margin="-8,12,-8,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ProblemRowViewModel">
                                            <Button Classes="row" Command="{Binding OpenCommand}">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                    <Ellipse Grid.Column="0" Width="8" Height="8"
                                                             VerticalAlignment="Top" Margin="0,5,0,0"
                                                             Fill="{Binding SeverityBrush}" />
                                                    <StackPanel Grid.Column="1" Spacing="3">
                                                        <TextBlock Text="{Binding Title}" FontSize="12.5"
                                                                   Foreground="{DynamicResource FgBrush}"
                                                                   TextWrapping="Wrap" MaxLines="3"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding ScopeText}" FontSize="10.5"
                                                                   Foreground="{DynamicResource MutedBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Classes="link" HorizontalAlignment="Left" FontSize="12.5"
                    Content="{Binding NotesLine}" Command="{Binding OpenNotesCommand}">
                <Button.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="HasResult" />
                        <Binding Path="HasNotes" />
                    </MultiBinding>
                </Button.IsVisible>
            </Button>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="14" IsVisible="{Binding HasResult}">

                <!-- SEC-07: what the user's unelevated session can write that elevated programs also search. -->
                <Border Grid.Column="0" Classes="panel">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="phead" Text="UAC EXPOSURE" />
                        <TextBlock Text="{Binding UacHeadline}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{Binding UacBrush}" />
                        <TextBlock Text="{Binding UacDetail}" Classes="help" />
                        <ItemsControl ItemsSource="{Binding UacFolders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <controls:CharWrapTextBlock Source="{Binding}" Classes="mono" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="link" HorizontalAlignment="Left" FontSize="12" Content="See the finding"
                                Command="{Binding OpenUacCommand}"
                                IsVisible="{Binding UacGroup, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                </Border>

                <!-- COR-08's limits, as bars. -->
                <Border Grid.Column="1" Classes="panel">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="phead" Text="LENGTH HEADROOM" />
                        <ItemsControl ItemsSource="{Binding Headroom}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HeadroomBarViewModel">
                                    <StackPanel Spacing="4" Margin="0,0,0,10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="field"
                                                       FontSize="12" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" Classes="help"
                                                       Margin="8,0,0,0" />
                                        </Grid>
                                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding Fraction}" Height="6"
                                                     MinHeight="6" CornerRadius="3"
                                                     Foreground="{Binding Brush}"
                                                     Background="{DynamicResource ButtonBgBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding StoredLengths}" Classes="help" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Classes="panel" IsVisible="{Binding HasResult}">
                <StackPanel Spacing="10">
                    <TextBlock Classes="phead" Text="WHAT THE SCAN LOOKED AT" />
                    <ItemsControl ItemsSource="{Binding ScanInfo}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:InfoRowViewModel">
                                <Grid ColumnDefinitions="150,*" Margin="0,3">
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="help" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="field"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
