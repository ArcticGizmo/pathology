<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows-only: PATHology diagnoses the Windows PATH, and reads it through Pathology.Windows
         (registry, ACLs, AuthZ). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Pathology.App</RootNamespace>
    <AssemblyName>pathology</AssemblyName>
    <Description>Windows PATH health: diagnose, explain and fix PATH security and correctness problems.</Description>
    <Version>0.1.0</Version>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The .exe icon (Explorer, taskbar pin). Regenerate from pathology.svg with tools/gen-icons.ps1. -->
    <ApplicationIcon>Assets\pathology.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Includes pathology.ico, loaded at runtime as the window icon (Views/AppIcon.cs). -->
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The changelog is embedded so the app can render it at runtime — the About "What's new"
         viewer and the post-update window both read it (assembly manifest name "Pathology.CHANGELOG.md"). -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="Pathology.CHANGELOG.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />
    <PackageReference Include="Avalonia.Headless" Version="12.0.5" />
    <!-- Curated WCAG-AA palettes with a live ThemeManager. PATHology is fixed to Nord (Dark); see
         Theming/NordTheme.cs for how its tokens map onto the brush keys the views use. -->
    <PackageReference Include="ArcticGizmo.Avalonia.Palette" Version="0.3.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Renders the Learn articles (Controls/MarkdownBlock.cs), as perch does. -->
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pathology.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pathology.Core\Pathology.Core.csproj" />
    <ProjectReference Include="..\Pathology.Windows\Pathology.Windows.csproj" />
  </ItemGroup>

</Project>
